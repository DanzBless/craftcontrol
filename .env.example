# CraftControl Environment Configuration (Optional)
# Port for the web dashboard (Default: 3000)
PORT=3000

# 9Router AI Gateway Configuration (Optional - for AI Copilot features)
# Local or remote 9Router gateway URL
NINEROUTER_URL=http://localhost:20128

# Your 9Router API Key (Leave blank if auth is disabled on your 9Router)
NINEROUTER_KEY=

# Default AI Model (Default: ag/gemini-3.8-flash-low)
NINEROUTER_MODEL=ag/gemini-3.8-flash-low
