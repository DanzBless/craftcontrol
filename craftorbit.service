[Unit]
Description=CraftOrbit Universal Minecraft Server Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/craftorbit
ExecStart=/usr/bin/node /opt/craftorbit/server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000

# Standard security sandbox options for systemd services
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
